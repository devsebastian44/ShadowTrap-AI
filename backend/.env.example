# ─── ShadowTrap AI - Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values

# App
APP_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key-32-chars

# MongoDB
MONGODB_URL=mongodb://shadowtrap_user:shadowtrap_pass@mongo:27017/shadowtrap
MONGODB_DB=shadowtrap

# Cowrie log path (mounted volume)
COWRIE_LOG_PATH=/cowrie/var/log/cowrie/cowrie.json

# GeoIP (optional — download GeoLite2-City.mmdb from MaxMind)
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# ─── Telegram Alerts (optional) ───────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Discord Alerts (optional) ────────────────────────────────────────────────
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# ─── Alert Thresholds ─────────────────────────────────────────────────────────
# Fire alert when X attempts come from same IP within Y seconds
ALERT_THRESHOLD_ATTEMPTS=10
ALERT_THRESHOLD_WINDOW_SECONDS=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list
# CORS_ORIGINS=["http://localhost:8080","https://yourdomain.com"]
